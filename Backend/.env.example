# Groq is auto-selected when GROQ_API_KEY is set.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# To use xAI instead, set CHAT_PROVIDER=xai and configure an xAI key/model.
# CHAT_PROVIDER=xai
# XAI_API_KEY=your-xai-api-key
# GROK_MODEL=grok-4.7

# Optional: semantic resume search. Local keyword search works without this.
# JINA_API_KEY=your-jina-api-key
